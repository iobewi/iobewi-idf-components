menu "HLS Player Configuration"

    choice APP_HLS_LOG_MODE
        prompt "HLS log mode"
        default APP_HLS_LOG_MODE_PROD
        help
            Controls runtime observability verbosity for HLS player.

            PROD: silent run (errors + critical warnings only)
            RUN: PROD + sparse summaries
            DIAG_LIGHT: RUN + throttled timing/heartbeat metrics
            DIAG_HEAVY: DIAG_LIGHT + detailed traces and playlist dumps

    config APP_HLS_LOG_MODE_PROD
        bool "PROD"

    config APP_HLS_LOG_MODE_RUN
        bool "RUN"

    config APP_HLS_LOG_MODE_DIAG_LIGHT
        bool "DIAG_LIGHT"

    config APP_HLS_LOG_MODE_DIAG_HEAVY
        bool "DIAG_HEAVY"

    endchoice

    config APP_HLS_LOG_THROTTLE_MS
        int "HLS log throttle min interval (ms)"
        default 5000
        range 100 60000

    config APP_HLS_LOG_SUMMARY_PERIOD_MS
        int "HLS summary period (ms)"
        default 30000
        range 1000 120000

    config APP_HLS_LOG_BURST_COUNT
        int "HLS log burst count"
        default 3
        range 1 20

    config APP_HLS_LOG_BURST_WINDOW_MS
        int "HLS log burst window (ms)"
        default 10000
        range 1000 120000

    config APP_HLS_LOG_SAMPLE_N_FAST
        int "HLS fast-loop sample 1/N"
        default 50
        range 1 1000
        help
            Sampling ratio used only in DIAG_LIGHT/DIAG_HEAVY for high-frequency logs.
            Ignored in PROD/RUN modes.

    config APP_HLS_LOG_SAMPLE_N_SLOW
        int "HLS slow-loop sample 1/N"
        default 10
        range 1 1000
        help
            Sampling ratio used only in DIAG_LIGHT/DIAG_HEAVY for medium-frequency logs.
            Ignored in PROD/RUN modes.

    config APP_HLS_PLAYER_RING_BUFFER_SIZE
        int "Ring buffer size (KB)"
        default 512 if SPIRAM
        default 64 if !SPIRAM
        range 32 1024
        help
            Size of the ring buffer for streaming data in KB.

            Recommended values:
            - With PSRAM: 512-768 KB (mitigation drop-old escalation)
            - Without PSRAM: 64-96 KB (balance RAM/stability)

            Larger buffer = more latency but more resilient to drop-old spirals.
            H1 mitigation: 512 KB gives breathing room for producer/consumer imbalance.

    config APP_HLS_PLAYER_DEC_BUFFER_SIZE
        int "Decoded buffer size (KB)"
        default 16
        range 8 32
        help
            Size of the output PCM buffer in KB.

            Default 16 KB is sufficient for most cases (48kHz stereo).
            Only increase if you experience audio glitches with high sample rates.

    config APP_HLS_PLAYER_GATHER_BUFFER_SIZE
        int "Gather buffer size (KB)"
        default 8
        range 4 16
        help
            Size of the gather buffer for assembling TS packets before decoding.

            The decoder needs a contiguous window of several KB to extract AAC frames.
            Items in the ring buffer are 188 bytes (1 TS packet), but the decoder
            needs 4-8 KB to work efficiently.

            Recommended values:
            - 4 KB: minimum, ~21 TS packets
            - 8 KB: optimal for most streams, ~42 TS packets
            - 16 KB: maximum, use only if experiencing frequent decode errors

    config APP_HLS_PLAYER_DROP_OLD_ON_FULL
        bool "Enable legacy drop-old strategy when ring buffer full"
        default n
        help
            When enabled, if the ring buffer is full, the oldest items are dropped
            until a PUSI boundary (PES start) is found, then the new data is inserted.

            Legacy behavior: maintains live-ness by discarding old TS packets.
            This can corrupt PES/AAC continuity and produce audible jumps.
            Recommended: keep disabled and rely on backpressure.

    config APP_HLS_PLAYER_STACK_DIAG
        bool "Enable stack diagnostics (HWM logging)"
        default n
        help
            Enable periodic stack High Water Mark (HWM) logging for fetch and audio tasks.

            When enabled, logs HWM every 5 seconds (debug level) to help identify
            optimal stack sizes for P0.1 stack reduction.

            Disable in production to avoid log spam.

    config APP_HLS_PLAYER_RINGBUF_DIAG
        bool "Enable ringbuffer occupancy diagnostics"
        default y
        help
            Enable periodic ringbuffer occupancy logging (used/free/percent).

            Logs occupancy at key events (write segment, drop-old, NOTIF_RESYNC/RESET)
            to diagnose producer/consumer imbalance.

            Critical for identifying if drop-old escalation is caused by:
            - Producer too aggressive (buffer always >90%)
            - Consumer stall (buffer grows despite slow producer)

    config APP_HLS_PLAYER_BACKPRESSURE
        bool "Enable fetcher backpressure"
        default y
        help
            Enable automatic backpressure on the fetcher task when ringbuffer is high.

            When enabled, the fetcher will pause downloads if ringbuffer occupancy
            exceeds the high threshold (80%), and resume when it drops below the low
            threshold (60%).

            This prevents drop-old escalation spirals by slowing down the producer
            when the consumer cannot keep up.

    config APP_HLS_PLAYER_BACKPRESSURE_HIGH
        int "Backpressure high threshold (%)"
        depends on APP_HLS_PLAYER_BACKPRESSURE
        default 80
        range 50 95
        help
            Ringbuffer occupancy threshold (%) to trigger backpressure pause.

    config APP_HLS_PLAYER_BACKPRESSURE_LOW
        int "Backpressure low threshold (%)"
        depends on APP_HLS_PLAYER_BACKPRESSURE
        default 60
        range 30 90
        help
            Ringbuffer occupancy threshold (%) to resume after backpressure pause.


    config APP_HLS_PLAYER_TS_ADMISSION_HIGH
        int "TS admission high threshold (%)"
        default 75
        range 40 95
        help
            Ringbuffer occupancy threshold (%) above which fetcher will not start
            a new TS segment download.

    config APP_HLS_PLAYER_TS_ADMISSION_LOW
        int "TS admission low threshold (%)"
        default 55
        range 20 90
        help
            Ringbuffer occupancy threshold (%) below which fetcher resumes TS
            downloads after an admission block.

    config APP_HLS_RB_GATING_ENABLE
        bool "Enable ringbuffer free-space gating for TS download"
        default y
        help
            When enabled, the fetcher waits for enough ringbuffer free-space
            before each HTTP read chunk. This avoids long blocking waits inside
            xRingbufferSend() and naturally applies TCP/TLS backpressure.

    config APP_HLS_RB_READ_CHUNK_BYTES
        int "TS read chunk size (bytes)"
        depends on APP_HLS_RB_GATING_ENABLE
        default 3760
        range 188 16384
        help
            HTTP read chunk size used by gating mode.
            A multiple of 188 bytes is recommended to reduce carry churn.

    config APP_HLS_RB_MIN_FREE_BEFORE_READ_BYTES
        int "Min ringbuffer free-space before HTTP read (bytes)"
        depends on APP_HLS_RB_GATING_ENABLE
        default 11280
        range 188 524288
        help
            Minimum free-space required before calling esp_http_client_read().
            Recommended >= 2-3x read chunk size.

    config APP_HLS_RB_START_TS_MIN_FREE_BYTES
        int "Min ringbuffer free-space to start a TS segment (bytes)"
        depends on APP_HLS_RB_GATING_ENABLE
        default 65536
        range 188 1048576
        help
            Admission block threshold in bytes.

    config APP_HLS_RB_RESUME_TS_MIN_FREE_BYTES
        int "Min ringbuffer free-space to resume TS segment start (bytes)"
        depends on APP_HLS_RB_GATING_ENABLE
        default 81920
        range 188 1048576
        help
            Admission resume threshold in bytes (hysteresis).
            At runtime, resume is clamped to ringbuffer capacity and forced
            to be >= start threshold.

    config APP_HLS_RB_GATING_POLL_MS
        int "Ringbuffer gating poll interval (ms)"
        depends on APP_HLS_RB_GATING_ENABLE
        default 20
        range 1 200
        help
            Sleep interval while waiting for ringbuffer free-space.

    config APP_HLS_RB_SEND_MAX_WAIT_MS
        int "Warn threshold for non-blocking ringbuffer send wait (ms)"
        depends on APP_HLS_RB_GATING_ENABLE
        default 200
        range 1 5000
        help
            Warning threshold for cumulative wait in xRingbufferSend(..., 0)
            retry loops while gating mode is enabled.
            Exceeding this limit emits a stall warning but does not abort
            the segment transfer.

    config APP_HLS_LIVE_CATCHUP_ENABLE
        bool "Enable live catch-up mode"
        default y
        help
            Enable STEADY/CATCHUP state machine to reduce repeated live-window drops.

    config APP_HLS_CATCHUP_ENTER_CONSECUTIVE
        int "Catch-up enter consecutive detections"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 2
        range 1 10

    config APP_HLS_CATCHUP_EXIT_CONSECUTIVE
        int "Catch-up exit consecutive confirmations"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 2
        range 1 10

    config APP_HLS_LIVE_EDGE_BACKOFF_MIN
        int "Live-edge backoff min (segments)"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 1
        range 0 10

    config APP_HLS_LIVE_EDGE_BACKOFF_MAX
        int "Live-edge backoff max (segments)"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 3
        range 1 15

    config APP_HLS_CATCHUP_SOFT_GAP
        int "Soft catch-up gap threshold (segments)"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 2
        range 1 20

    config APP_HLS_CATCHUP_HARD_GAP
        int "Hard catch-up gap threshold (segments)"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 4
        range 1 40

    config APP_HLS_CATCHUP_RESYNC_COOLDOWN_MS
        int "Hard resync cooldown (ms)"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 8000
        range 0 120000

    config APP_HLS_SEG_PER_CYCLE_STEADY_MAX
        int "Segments per cycle max in steady mode"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 2
        range 1 8

    config APP_HLS_SEG_PER_CYCLE_CATCHUP_MAX
        int "Segments per cycle max in catch-up mode"
        depends on APP_HLS_LIVE_CATCHUP_ENABLE
        default 3
        range 1 8


endmenu
