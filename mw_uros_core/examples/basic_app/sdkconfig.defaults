# micro-ROS Core Basic App - Default Configuration

# ESP-IDF system
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# micro-ROS transport (choose one)
# CONFIG_MICRO_ROS_TRANSPORT_UART=y
# CONFIG_MICRO_ROS_TRANSPORT_UDP=y
CONFIG_MICRO_ROS_TRANSPORT_USB_CDC=y

# WiFi (if using UDP transport)
# CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# Networking (if using UDP transport)
# CONFIG_LWIP_MAX_SOCKETS=16
# CONFIG_LWIP_SO_RCVBUF=y
