menu "A02 Provider Example Configuration"

    config A02_PROVIDER_UART_RX_GPIO
        int "UART RX GPIO"
        default 18
        help
            GPIO connected to A02YYUW TX pin (UART RX)

    config A02_PROVIDER_MODE_GPIO
        int "Mode GPIO"
        default 5
        help
            GPIO connected to A02YYUW RX pin (mode control)

    config A02_PROVIDER_EN_GPIO_0
        int "EN GPIO Sensor 0"
        default 14
        help
            GPIO for STMPS2141STR EN (sensor 0)

    config A02_PROVIDER_EN_GPIO_1
        int "EN GPIO Sensor 1"
        default 10
        help
            GPIO for STMPS2141STR EN (sensor 1)

    config A02_PROVIDER_EN_GPIO_2
        int "EN GPIO Sensor 2"
        default 7
        help
            GPIO for STMPS2141STR EN (sensor 2)

    config A02_PROVIDER_EN_GPIO_3
        int "EN GPIO Sensor 3"
        default 4
        help
            GPIO for STMPS2141STR EN (sensor 3)

endmenu
