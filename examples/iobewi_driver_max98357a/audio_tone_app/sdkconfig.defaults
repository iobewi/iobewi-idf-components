# MAX98357A Audio Tone App - Default Configuration

# Enable ESP-IDF driver components
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Math library (for sine wave generation)
# Note: NEWLIB_NANO_FORMAT was renamed to LIBC_NEWLIB_NANO_FORMAT in ESP-IDF v6.0+
CONFIG_LIBC_NEWLIB_NANO_FORMAT=n
