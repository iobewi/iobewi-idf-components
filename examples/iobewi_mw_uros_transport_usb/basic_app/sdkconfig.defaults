# USB-CDC Transport Middleware Basic App - Default Configuration

# ESP-IDF system
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# micro-ROS transport
CONFIG_MICRO_ROS_TRANSPORT_USB_CDC=y

# TinyUSB configuration
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512

# USB device descriptor
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
