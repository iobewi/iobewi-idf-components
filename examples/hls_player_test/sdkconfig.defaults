# Wi-Fi Configuration (example defaults)
CONFIG_EXAMPLE_WIFI_SSID="YourSSID"
CONFIG_EXAMPLE_WIFI_PASSWORD="YourPassword"

# Enable PSRAM for better performance
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SIZE=-1

# HLS Player defaults
CONFIG_APP_HLS_PLAYER_RING_BUFFER_SIZE=128
CONFIG_APP_HLS_PLAYER_DEC_BUFFER_SIZE=16
CONFIG_APP_HLS_PLAYER_GATHER_BUFFER_SIZE=8
CONFIG_APP_HLS_PLAYER_DROP_OLD_ON_FULL=y

# Enable stack diagnostics for P0.1
CONFIG_APP_HLS_PLAYER_STACK_DIAG=n

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
