# ToF Scan Application Basic App - Default Configuration

# ESP-IDF system
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# I2C configuration
CONFIG_I2C_ENABLE_DEBUG_LOG=n

# micro-ROS scan configuration
CONFIG_MICRO_ROS_SCAN_BINS=360
CONFIG_MICRO_ROS_SCAN_BUILDER_ALLOC_MALLOC=y
CONFIG_MICRO_ROS_SCAN_ALLOC_GUARD=n

# ToF configuration
CONFIG_TOF_BIN_ALLOW_DUPLICATES=n
